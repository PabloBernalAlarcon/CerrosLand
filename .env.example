# Copy to .env (never commit .env).

# claude_code   -> your own Claude account through Claude Code (default; run `claude` then `/login` once)
# anthropic_api -> API key (future funded/institutional deployment)
# echo          -> offline, no model (tests and demos)
CERROS_PROVIDER=claude_code

# Optional model name or alias accepted by the provider. Leave empty to use the provider default.
CERROS_MODEL=

# Only for CERROS_PROVIDER=anthropic_api
ANTHROPIC_API_KEY=
